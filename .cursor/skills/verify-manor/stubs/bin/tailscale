#!/usr/bin/env node
// A stand-in Tailscale CLI for the spike, first on its PATH, so Settings → Phone never
// reads or changes the Mac's real tailnet. It answers the four calls Manor makes, as a
// signed-in Mac with HTTPS certificates, and keeps Manor's one serve mapping in a file
// under the spike HOME.
import { existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

const NAME = 'manor-spike.example.ts.net'
const state = join(process.env.HOME ?? '/tmp', '.tailscale-stub-serve')
const args = process.argv.slice(2)
const print = (value) => process.stdout.write(JSON.stringify(value))

if (args[0] === 'status') {
  print({ BackendState: 'Running', Self: { DNSName: `${NAME}.`, CapMap: { https: null } } })
} else if (args[0] === 'serve' && args[1] === 'status') {
  print(existsSync(state) ? { Web: { [`${NAME}:443`]: { Handlers: { '/': { Proxy: readFileSync(state, 'utf8') } } } } } : {})
} else if (args[0] === 'serve' && args.includes('--bg')) {
  writeFileSync(state, args.at(-1))
} else if (args[0] === 'serve' && args.at(-1) === 'off') {
  rmSync(state, { force: true })
} else {
  process.stderr.write(`tailscale stub: unknown call ${args.join(' ')}\n`)
  process.exit(1)
}
