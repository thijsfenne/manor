# A database file that does not exist yet is created with a starter household.
# One of sqlite | memory; unset means sqlite. Any other value stops startup.
MANOR_STORE=sqlite
# Defaults to ~/.manor/sqlite/manor.db. Use an absolute path when overriding.
# MANOR_SQLITE_PATH=

# Optional. Pins the one password account that clients on other devices sign in with.
# Not a secret: it is the allowlist of one. The desktop shell on this Mac needs no
# account; it reads the key the server writes to <data dir>/local-access-token.
# MANOR_OWNER_USER_ID=00000000-0000-4000-8000-000000000001

# The folder of notes behind the Knowledge tab. Any folder of markdown works, an
# Obsidian vault included. Unset, it is <data dir>/knowledge, or the folder picked in
# Settings. Set here, it wins and Settings cannot change it. A leading ~ is expanded.
# MANOR_VAULT_DIR=~/Documents/Notes

# Agent-to-agent messaging guardrails. Defaults are depth 2 and four receiver turns
# per originating message; zero disables that dimension without changing allowlists.
# MANOR_RELAY_DEPTH=2
# MANOR_RELAY_CAP=4

# How far agents may act outside the chat (the browser, the Mac, connector writes)
# without asking. One of auto | confirm | full-access; unset means auto. In auto an
# independent model allows what is clearly low impact and you are asked about the
# rest. It runs on Codex, or on Claude when Codex cannot answer; with neither signed
# in you are asked every time. confirm always asks. full-access never asks.
# MANOR_EFFECT_MODE=auto

# Apple Reminders. Off unless set to on. It also needs a Reminders command line tool
# on this Mac (remctl or remindctl); without one there is nothing to switch on.
# MANOR_REMINDERS=on

# Reminders lists you share with somebody, by title, comma separated. Agents never
# delete from a shared list. Reminders usually says itself that a list is shared; the
# names here still hold when it cannot.
# MANOR_REMINDERS_SHARED_LISTS=Groceries,Household

# The name Composio files your connected accounts under. Unset, it is manor. Set it
# only when you connected accounts under another name before.
# MANOR_COMPOSIO_USER_ID=manor

# Gmail accounts you connected in Composio before Manor used the aliases personal and
# work, as alias:account id, comma separated. Manor gives each its alias and keeps
# Composio in a recovery mode while one is missing. Most installs leave this unset.
# MANOR_COMPOSIO_GMAIL_ACCOUNTS=personal:ca_example

# mymind Artifacts. Create an API access key under mymind -> Settings ->
# Extensions. Manor only uses its read endpoints. Their UI calls the second value
# a private key; the API calls it a base64 secret. Both are server-only and must
# never enter VITE_* or the browser.
# MANOR_MYMIND_KEY_ID=
# MANOR_MYMIND_SECRET=

# Mail connector. App passwords, never the account password. Each mailbox is its
# own IMAP login; a second account is a second prefix, not a picker on the tools.
# MANOR_MAIL_IMAP_USER=owner@example.invalid
# MANOR_MAIL_IMAP_PASSWORD=

# Composio project API key (ak_*). When set, Manor creates one hosted multi-account
# MCP session. Connections use the aliases personal/work and every ambiguous call
# must select one explicitly; the key stays server-side. Plugins > Connectors can also
# save it, after Composio accepts it, into <data dir>/.env; a key set here or in the
# environment wins and the page then only says where it is set.
# COMPOSIO_API_KEY=

# Where memory lives: the daily log, long-term memory, agent notes, saved facts and the
# standing context files (soul.md, user-core.md, rules.md). Unset, it is
# <data dir>/memory, or the folder picked in Settings, and a new install gets starter
# files there. Point it at a folder you already keep, such as a notes repository, and
# Manor uses that folder as it is: finished days of the daily log are distilled into
# memory/long-term.md only in a folder that has that file. Set here, it wins and
# Settings cannot change it.
# MANOR_MEMORY_DIR=~/.manor/memory
