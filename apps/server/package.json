{
  "name": "@manor/server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node scripts/build-mcp.mjs .mcp-build/${MANOR_PORT:-8787} && MANOR_MCP_COMPILED_DIR=.mcp-build/${MANOR_PORT:-8787} tsx --env-file-if-exists=.env src/main.ts",
    "build:mcp": "node scripts/build-mcp.mjs",
    "check:codex-protocol": "tsx scripts/check-codex-protocol.ts",
    "check:claude-lazy-mcp": "tsx scripts/check-claude-lazy-mcp.ts",
    "check:claude-entrypoint": "tsx scripts/check-claude-entrypoint.ts",
    "smoke:mail": "tsx --env-file-if-exists=.env src/mcp/mailSmoke.ts",
    "register:mail": "tsx --env-file-if-exists=.env src/mcp/registerMail.ts",
    "register:calendar": "tsx --env-file-if-exists=.env src/mcp/registerConnector.ts calendar",
    "register:reminders": "tsx --env-file-if-exists=.env src/mcp/registerConnector.ts reminders",
    "register:codex-computer": "tsx --env-file-if-exists=.env src/mcp/registerConnector.ts codex-computer",
    "register:figma": "tsx --env-file-if-exists=.env src/mcp/registerFigma.ts",
    "register:paper": "tsx --env-file-if-exists=.env src/mcp/registerPaper.ts",
    "provision:computer": "bash scripts/provision-computer.sh",
    "build:computer": "bash scripts/build-computer-driver.sh",
    "register:computer": "tsx --env-file-if-exists=.env src/mcp/registerComputer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backup:sqlite": "tsx --env-file-if-exists=.env src/backupSqlite.ts",
    "backup:install": "bash scripts/install-backup-agent.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@manor/contracts": "workspace:*",
    "cron-parser": "^5.10.0",
    "fflate": "^0.8.3",
    "ical.js": "^2.2.1",
    "imapflow": "^1.7.1",
    "nodemailer": "^10.0.16",
    "tsdav": "^2.3.4",
    "unpdf": "^1.8.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@manor/client-runtime": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.13",
    "esbuild": "0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
