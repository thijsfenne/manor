#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
# A push from a linked worktree hands the hook GIT_DIR. Every `git init` the tests
# run in a temp dir would then re-initialise this repository instead, flipping the
# shared config to `bare = true` and failing the suite.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
scripts/check-public.sh
pnpm -r typecheck
pnpm -r test
