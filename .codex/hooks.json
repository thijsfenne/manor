{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/session-context.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/capture-review-turn.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/check-colors.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/auto-review.sh\"",
            "timeout": 30,
            "statusMessage": "Checking review status"
          }
        ]
      }
    ]
  }
}
